{
  "name": "deepseek-harness-tui",
  "version": "0.1.4",
  "description": "Interactive terminal UI for deepseek-harness, installed as a dsh profile bundle",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demo-0416/deepseek-harness-tui.git"
  },
  "homepage": "https://github.com/Demo-0416/deepseek-harness-tui#readme",
  "bugs": {
    "url": "https://github.com/Demo-0416/deepseek-harness-tui/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tui",
    "terminal",
    "cli",
    "agent",
    "ai"
  ],
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir lib/types && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
